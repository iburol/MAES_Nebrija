        </div>

        <div class="proceso-card">
          <h3>Buenas prácticas</h3>
          <ul class="proceso-lista">
            <li>Usar nombres claros.</li>
            <li>Separar inicialización y lógica principal.</li>
            <li>Comentar los bloques importantes.</li>
            <li>Justificar registros y periféricos.</li>
            <li>Evitar copiar código sin entenderlo.</li>
          </ul>
        </div>
      </div>

      <h4 class="proceso-subtitulo">Estructura recomendada del código</h4>

      <pre class="proceso-codigo">#define F_CPU 16000000UL

#include &lt;avr/io.h&gt;
#include &lt;avr/interrupt.h&gt;
#include &lt;util/delay.h&gt;

/* Definición de constantes */
#define LED_PIN PB5

/* Variables globales */
volatile unsigned char estado = 0;

/* Prototipos de funciones */
void Puertos_Init(void);
void Perifericos_Init(void);

int main(void)
{
    Puertos_Init();
    Perifericos_Init();

    sei();

    while (1)
    {
        /*
         * Lógica principal del programa.
         */
    }

    return 0;
}

void Puertos_Init(void)
{
    DDRB |= (1 &lt;&lt; LED_PIN);
}

void Perifericos_Init(void)
{
    /*
     * Configuración de ADC, TIMER, PWM, USART,
     * interrupciones externas u otros periféricos.
     */
}

ISR(TIMER1_COMPA_vect)
{
    /*
     * Código que se ejecuta cuando ocurre
     * el evento asociado a la interrupción.
     */
}</pre>

      <h4 class="proceso-subtitulo">Relación entre algoritmo y código</h4>

      <div class="proceso-tabla-contenedor">
        <table class="proceso-tabla">
          <thead>
            <tr>
              <th>Elemento del algoritmo</th>
              <th>Traducción al programa en C</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="proceso-etiqueta">Configurar entradas y salidas</td>
              <td>Uso de DDRB, DDRC, DDRD, PORTB, PORTC o PORTD.</td>
            </tr>
            <tr>
              <td class="proceso-etiqueta">Leer una entrada digital</td>
              <td>Consulta de PINx o uso de una interrupción externa como INT0.</td>
            </tr>
            <tr>
              <td class="proceso-etiqueta">Leer una entrada analógica</td>
              <td>Configuración del ADC y lectura de ADCH, ADCL o del resultado completo.</td>
            </tr>
            <tr>
              <td class="proceso-etiqueta">Controlar una salida</td>
              <td>Modificación de PORTx o actualización de señales PWM.</td>
            </tr>
            <tr>
              <td class="proceso-etiqueta">Generar una temporización</td>
              <td>Configuración de TIMER0, TIMER1 u OCR1A/OCR1B.</td>
            </tr>
            <tr>
              <td class="proceso-etiqueta">Enviar o recibir datos</td>
              <td>Configuración de USART y uso de UDR0, UCSR0A, UCSR0B o UBRR0.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="proceso-aviso">
        Los comentarios deben explicar la intención del código, no solo repetir lo que hace cada línea.
      </div>
    </div>
